# Supabase (a NEW project for the Angel Tree, separate from OptiEatsAI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Who may open /admin (comma separated, signs in with an emailed link)
ANGEL_ADMIN_EMAILS=

# Reads family emails and PDFs on the import screen
ANTHROPIC_API_KEY=

# Optional: sponsor confirmation emails (Resend). Without it the claim still works.
RESEND_API_KEY=
ANGEL_FROM_EMAIL="Angel Tree <angeltree@optimaxproai.com>"

# Organizer-confirmed gift drop-off details. Until address and hours are set, sponsors see a follow-up email notice.
ANGEL_DROP_OFF_LOCATION=
ANGEL_DROP_OFF_ADDRESS=
ANGEL_DROP_OFF_HOURS=
ANGEL_DROP_OFF_INSTRUCTIONS=

# Public URL used in emails, e.g. https://angeltree.optimaxproai.com
NEXT_PUBLIC_SITE_URL=

# LOCAL PREVIEW ONLY. Fills the site with 60 fictional children and lets you click through
# admin without Supabase. Ignored when VERCEL_ENV=production. Never set this in production.
ANGEL_DEMO=
